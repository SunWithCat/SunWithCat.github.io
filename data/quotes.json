{
  "quotes": [
    {
      "content": "从今若许逍遥去，游戏坊间不思归。",
      "source": "SunWithCat"
    },
    {
      "content": "昔日观剑历四载，今朝匣底出龙吟。",
      "source": "SunWithCat"
    },
    {
      "content": "挽弓可落九天月，策马能平万云。",
      "source": "SunWithCat"
    },
    {
      "content": "人生如逆旅，我亦是行人。",
      "source": "苏轼《临江仙·送钱穆父》"
    },
    {
      "content": "山高月小，水落石出。",
      "source": "苏轼《后赤壁赋》"
    },
    {
      "content": "竹杖芒鞋轻胜马，谁怕？一蓑烟雨任平生。",
      "source": "苏轼《定风波》"
    },
    {
      "content": "回首向来萧瑟处，归去，也无风雨也无晴。",
      "source": "苏轼《定风波》"
    },
    {
      "content": "此心安处是吾乡。",
      "source": "苏轼《定风波·南海归赠王定国侍人寓娘》"
    },
    {
      "content": "浮名浮利，虚苦劳神。叹隙中驹，石中火，梦中身。",
      "source": "苏轼《行香子·述怀》"
    }
  ]
}
